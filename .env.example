# Copia este archivo como .env (cp .env.example .env) y añade tu clave opcional.
# SPHEREx SkyChrono funciona al 100% sin claves gracias a su motor astrofisico determinista local.

GEMINI_API_KEY=
# Opcional: OPENAI_API_KEY= (si prefieres OpenAI)
# Opcional: GEMINI_MODEL= / OPENAI_MODEL= para forzar un modelo; vacío = la app elige el mejor disponible para tu clave
GEMINI_MODEL=
PORT=8050
